# Environment
.env
*.env

# Node
node_modules/
package-lock.json

# Conda / venv
venv/
env/
.conda/

# Data outputs (don't commit generated files)
data/
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Credentials (extra safety net)
credentials.json
token.json
service_account*.json

docker

# Accidental shell-redirect artifacts (docker build progress lines; '[internal]' is a BuildKit step label)
\[internal\]
requirements.txt;*

# Firebase CLI cache
.firebase/
firebase-debug.log
firebase-debug.*.log

# Claude Code
.claude/

# MCP Playwright (snapshots and console logs from iterative browser sessions)
.playwright-mcp/
.mcp-playwright/
playwright-state.json

# Throwaway screenshots from local iteration sessions
/*.png
/*.jpg
/*.jpeg

*.cache

# Eval fixtures holding third-party full text (public repo: ids/urls/snippets only are tracked)
evals/fixtures/private/

# Downloaded service-account keys (see CLAUDE.md: local Firebase Admin runs)
key.json
key*.json
